<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AssemblyName>Eclipse</AssemblyName>
        <RootNamespace>Eclipse</RootNamespace>
        <Version>0.1.0</Version>
        <Description>Eclipse: Mi primer Mod de Among Us</Description>
        <Authors>Fault</Authors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AllOfUs.MiraAPI" Version="0.5.0" />
        <PackageReference Include="Reactor" Version="2.5.0-ci.371" />
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735"
                          Private="false" ExcludeAssets="runtime;native" />
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.8.18"
                          PrivateAssets="all" />
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1"
                          PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Options\" />
      <Folder Include="Resources\Misc\" />
      <Folder Include="Roles\Classic\Crewmate\Killing\Sheriff\Assets\" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources/Locale/*.xml" />
        <EmbeddedResource Include="Buttons/Assets/*.png" />
        <EmbeddedResource Include="Roles/**/Assets/*.png" />
        <EmbeddedResource Include="Modifiers/**/Assets/*.png" />
    </ItemGroup>
    
    <ItemGroup>
      <Compile Include="Roles\Universal\EclipseRoleMetadata.cs" />
    </ItemGroup>

</Project>